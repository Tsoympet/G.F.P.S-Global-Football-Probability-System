# Core application settings
SECRET_KEY=  # REQUIRED: Generate with `openssl rand -hex 32` - DO NOT use default in production
DATABASE_URL=sqlite:///./gfps.db
FRONTEND_BASE_URL=https://example.com
ALLOWED_ORIGINS=http://localhost:1420,http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WINDOW_SEC=60

# Live data streamer
STREAMER_ENABLED=false
STREAMER_INTERVAL_SEC=15

# ⚠️ EXPENSIVE PREMIUM API - NOT RECOMMENDED ⚠️
# API-Football requires a paid subscription (~$50-300/month)
# GFPS works perfectly fine with FREE data sources (see below)
# Only set this if you already have a subscription and need live odds
APIFOOTBALL_KEY=

# Data provider settings (FREE ALTERNATIVES - RECOMMENDED)
# These providers work together to give you complete data at NO COST:
# - OpenFootball CSV: Bundled fixtures/results (no key needed)
# - Football-Data.org: Free tier API (optional, requires free API key)
# - OpenLigaDB: Free live scores for German leagues (no key needed)
ENABLE_FOOTBALL_DATA=1
ENABLE_OPENLIGADB=1
ENABLE_API_FOOTBALL=0      # Leave disabled - uses expensive premium API
ENABLE_WEB_SCRAPER=0
ENABLE_LIVE_NETWORK=0
SCRAPER_CONFIG_PATH=

# Snapshot persistence
SNAPSHOT_INTERVAL_SEC=60

# Modelling controls
MODEL_VERSION=ens_v2.1
EV_MIN_THRESHOLD=0.02
FORM_WINDOW=5
DIXON_COLES_RHO=-0.08
FORM_ADJUSTMENT_WEIGHT=0.15
BASE_HOME_GOALS=1.45
BASE_AWAY_GOALS=1.15
MARKET_WEIGHT_MIN=0.35
MARKET_WEIGHT_MAX=0.7
MIN_GOAL_RATE=0.05

# Alert engine
ALERT_ENGINE=false
ALERT_ENGINE_INTERVAL_SEC=120

# Notifications
FCM_SERVER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Auth / identity providers
GOOGLE_CLIENT_ID=
# To add more OAuth providers (Facebook, Twitter, GitHub, etc.):
# 1. Add CLIENT_ID/SECRET environment variables
# 2. Install the appropriate OAuth library (e.g., authlib)
# 3. Add a new endpoint following the pattern in backend/google_auth.py
