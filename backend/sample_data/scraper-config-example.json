{
  "_comment": "Example configuration for the WebScraperProvider with advanced features",
  "_usage": "Set SCRAPER_CONFIG_PATH to point to this file, or provide as config dict to WebScraperProvider",
  
  "fixtures_url": "https://example.com/fixtures",
  "results_url": "https://example.com/results",
  
  "_comment_js": "Enable JavaScript rendering for dynamic websites (requires Playwright)",
  "use_js_rendering": false,
  "js_wait_time": 2000,
  
  "_comment_pagination": "Multi-page pagination support",
  "pagination": {
    "enabled": false,
    "type": "url_pattern",
    "_types": "url_pattern, click, or scroll",
    "next_button_selector": "",
    "url_pattern": "?page={page}",
    "max_pages": 10
  },
  
  "_comment_proxy": "Proxy support for geo-restricted content",
  "proxy": {
    "enabled": false,
    "server": "http://proxy.example.com:8080",
    "username": "",
    "password": ""
  },
  
  "_comment_captcha": "Captcha detection (use set_captcha_handler() to provide solver)",
  "captcha_detection": {
    "enabled": false,
    "indicators": ["captcha", "recaptcha", "hcaptcha", "cloudflare"]
  },
  
  "_comment_monitoring": "HTML structure change detection/alerting",
  "structure_monitoring": {
    "enabled": false,
    "similarity_threshold": 0.8
  },
  
  "_comment_learning": "Automatic selector learning/discovery",
  "auto_selector_learning": {
    "enabled": false
  },
  
  "selectors": {
    "_comment": "CSS selectors for extracting fixture data from HTML",
    "fixture_container": ".match-container",
    "fixture_id": ".match-id",
    "home_team": ".home-team",
    "away_team": ".away-team",
    "kickoff": ".match-time",
    "league": ".league-name",
    "season": ".season",
    "venue": ".venue"
  },
  
  "result_selectors": {
    "_comment": "CSS selectors for extracting result-specific data (scores)",
    "home_score": ".home-score",
    "away_score": ".away-score",
    "status": ".match-status"
  },
  
  "examples": {
    "_comment": "Examples for common football data websites",
    "example_1_basic": {
      "description": "Basic scraping without advanced features",
      "fixtures_url": "https://example-sports-site.com/upcoming-matches",
      "selectors": {
        "fixture_container": "div.fixture-row",
        "fixture_id": "data-match-id",
        "home_team": "span.team.home",
        "away_team": "span.team.away",
        "kickoff": "time[datetime]",
        "league": "div.competition-name",
        "season": "span.season-year"
      }
    },
    "example_2_javascript": {
      "description": "JavaScript rendering for dynamic sites",
      "use_js_rendering": true,
      "js_wait_time": 3000,
      "fixtures_url": "https://dynamic-site.com/matches",
      "selectors": {
        "fixture_container": "div.match-card",
        "home_team": ".home .name",
        "away_team": ".away .name"
      }
    },
    "example_3_pagination": {
      "description": "URL-based pagination",
      "fixtures_url": "https://example.com/fixtures",
      "pagination": {
        "enabled": true,
        "type": "url_pattern",
        "url_pattern": "?page={page}",
        "max_pages": 5
      },
      "selectors": {
        "fixture_container": "tr.match-row"
      }
    },
    "example_4_proxy": {
      "description": "Using proxy for geo-restricted content",
      "proxy": {
        "enabled": true,
        "server": "http://proxy.example.com:8080"
      },
      "fixtures_url": "https://geo-restricted-site.com/fixtures"
    }
  }
}
